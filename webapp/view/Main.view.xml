<mvc:View
    controllerName="ZFI_INTERCO.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true">

    <App id="icAppRoot">

        <uxap:ObjectPageLayout
            id="mainPage"
            busy="{/appState/isBusy}"
            showFooter="true"
            alwaysShowContentHeader="false"
            upperCaseAnchorBar="false"
            enableLazyLoading="false"
            backgroundDesignAnchorBar="Solid">

            <uxap:headerTitle>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.OPHeaderTitle" type="XML"/>
            </uxap:headerTitle>

            <uxap:headerContent>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.OPHeaderContent" type="XML"/>
            </uxap:headerContent>

            <uxap:sections>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionHeaderData"    type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionPartyDetails"  type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionDocDetails"    type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionInitiatorGL"   type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionRecipientGL"   type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionAttachments"   type="XML"/>
                <core:Fragment fragmentName="ZFI_INTERCO.fragment.SectionWorkflow"      type="XML"/>
            </uxap:sections>

            <uxap:footer>
                <OverflowToolbar>
                    <Button text="Delete Draft"
                            type="Negative"
                            icon="sap-icon://delete"
                            press="onDeleteDraft"/>
                    <ToolbarSpacer/>
                    <Button text="Cancel"
                            icon="sap-icon://cancel"
                            press="onCancel"/>
                    <Button text="Save as Draft (F5)"
                            icon="sap-icon://save"
                            press="onSaveDraft"
                            class="sapUiSmallMarginBegin"/>
                    <Button text="Submit to Recipient (F8)"
                            type="Emphasized"
                            icon="sap-icon://outbox"
                            press="onSubmitToRecipient"
                            class="sapUiSmallMarginBegin"/>
                </OverflowToolbar>
            </uxap:footer>

        </uxap:ObjectPageLayout>
    </App>
</mvc:View>
